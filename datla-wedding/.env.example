# Copy to .env.local and fill in as needed.

# Public URL used in the WhatsApp share message. Falls back to the current page URL.
NEXT_PUBLIC_SITE_URL=

# RSVP storage. By default submissions are appended to .data/rsvps.json.
# Override the file location:
# RSVP_FILE=/absolute/path/rsvps.json
#
# Or send each submission to a Google Sheets webhook instead (needed on
# serverless hosts like Vercel, whose filesystem is read-only). A Google Apps
# Script web app with this doPost works:
#
#   function doPost(e) {
#     const d = JSON.parse(e.postData.contents);
#     SpreadsheetApp.getActiveSheet().appendRow(
#       [d.submittedAt, d.name, d.attending ? "Yes" : "No", d.guests, d.message]);
#     return ContentService.createTextOutput("ok");
#   }
RSVP_WEBHOOK_URL=
